# Copy to .env and fill in. .env is gitignored.

# Strava — same app you created at strava.com/settings/api
STRAVA_CLIENT_ID=208554
STRAVA_CLIENT_SECRET=
# Filled in automatically after the first OAuth run (see ingest_strava.py --auth)
STRAVA_REFRESH_TOKEN=

# Garmin Connect — your regular login. Used only locally by python-garminconnect.
GARMIN_EMAIL=
GARMIN_PASSWORD=
